# ============================================================================
# Mess Manager — API server environment variables
# Copy this file to `.env` and fill in real values. Do not commit `.env`.
# ============================================================================

# HTTP port the API server listens on (required)
PORT=5000

# Postgres connection string used by Drizzle ORM. For Neon, copy the
# "Pooled connection" string from the Neon dashboard and prepend
# `?sslmode=require` if not already present, e.g.
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Comma-separated OAuth client IDs from Google Cloud Console. Include every
# client that may request a Google ID token (Android, iOS, and web).
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# Resend (https://resend.com/api-keys) — used for OTP emails and invites.
# The "From" address must be a domain you've verified inside Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Mess Manager <noreply@yourdomain.com>"

# Optional: NODE_ENV controls logging verbosity (development | production).
# Leave unset locally; set to "production" on the host.
# NODE_ENV=development
